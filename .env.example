# Server Configuration
PORT=8081
ENVIRONMENT=development

# Redis Configuration
REDIS_HOST=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=100
REDIS_MIN_IDLE_CONNS=10
REDIS_MAX_RETRIES=2
REDIS_DIAL_TIMEOUT=1s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s

# PostgreSQL Configuration
DATABASE_URL=postgresql://redirect_service:password@localhost:5432/url_shortener?sslmode=require
DATABASE_MAX_CONNS=50
DATABASE_MIN_CONNS=5
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=5m
DATABASE_HEALTH_CHECK_PERIOD=1m

# Cache Configuration
CACHE_TTL=3600
CACHE_KEY_PREFIX=url:

# Timeout Configuration
REDIS_TIMEOUT=1s
DATABASE_TIMEOUT=5s
REQUEST_TIMEOUT=10s

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Metrics Configuration
METRICS_ENABLED=true
METRICS_PATH=/metrics

# GCP Configuration (for production)
GCP_PROJECT_ID=
GCP_REGION=us-central1
